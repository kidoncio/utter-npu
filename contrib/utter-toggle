#!/usr/bin/env python3
"""Start/stop Utter recording (bind this to a global shortcut, e.g. Meta+V).

The pill belongs to the daemon; this only sends "toggle" to its socket.
"""
import os
import socket
import subprocess
import sys

sock = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "utter.sock")
try:
    s = socket.socket(socket.AF_UNIX)
    s.connect(sock)
    s.sendall(b"toggle\n")
    print(s.recv(256).decode())
except OSError:
    # No daemon means no pill; fall back to a desktop notification.
    subprocess.run(["notify-send", "-a", "Utter", "-i", "dialog-error",
                    "Utter is not running", "systemctl --user start utter"])
    sys.exit(1)
